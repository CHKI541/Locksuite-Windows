<Window x:Class="LockSuite.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LockSuite.UI.ViewModels"
        mc:Ignorable="d"
        Title="LockSuite Windows — Filtro por Lista Blanca" 
        Height="650" Width="980"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar / Barra Lateral -->
        <Border Grid.Column="0" Background="#0F172A">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="20,24,20,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="24" Margin="0,0,10,0"/>
                        <TextBlock Text="LockSuite" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                    <TextBlock Text="Filtro Local Kosher" FontSize="11" Foreground="#94A3B8" Margin="34,2,0,0"/>
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel Grid.Row="1" Margin="10,0,10,0">
                    <RadioButton x:Name="NavEstado" Content="🛡️  Estado" 
                                 GroupName="NavGroup" IsChecked="True"
                                 Style="{DynamicResource NavButtonStyle}"
                                 Click="NavButton_Click" Tag="Estado"/>

                    <RadioButton x:Name="NavListaBlanca" Content="📋  Lista Blanca" 
                                 GroupName="NavGroup"
                                 Style="{DynamicResource NavButtonStyle}"
                                 Click="NavButton_Click" Tag="ListaBlanca"/>

                    <RadioButton x:Name="NavRecientes" Content="🔍  Bloqueados Recientes" 
                                 GroupName="NavGroup"
                                 Style="{DynamicResource NavButtonStyle}"
                                 Click="NavButton_Click" Tag="Recientes"/>

                    <RadioButton x:Name="NavConfig" Content="⚙️  Configuración" 
                                 GroupName="NavGroup"
                                 Style="{DynamicResource NavButtonStyle}"
                                 Click="NavButton_Click" Tag="Configuracion"/>

                    <RadioButton x:Name="NavAyuda" Content="❓  Ayuda / FAQ"
                                 GroupName="NavGroup"
                                 Style="{DynamicResource NavButtonStyle}"
                                 Click="NavButton_Click" Tag="Ayuda"/>
                </StackPanel>

                <!-- Footer / Tutor Status -->
                <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Margin="12,0,12,16" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Control Parental / Tutor" FontSize="11" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding IsAuthenticated, Converter={StaticResource AuthStatusConverter}}" 
                                   FontSize="13" FontWeight="SemiBold" 
                                   Foreground="{Binding IsAuthenticated, Converter={StaticResource AuthColorConverter}}"
                                   Margin="0,2,0,8"/>
                        <Button Content="{Binding IsAuthenticated, Converter={StaticResource AuthButtonTextConverter}}"
                                Height="28" Background="#334155" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                Click="BtnAuthTutor_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="Medium" Foreground="#334155"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="🔄 Actualizar" Height="28" Padding="10,0"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1"
                                BorderThickness="1" Cursor="Hand" Click="BtnRefresh_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Views Container -->
            <Grid Grid.Row="1" Margin="24">

                <!-- 1. VISTA: ESTADO -->
                <ScrollViewer x:Name="ViewEstado" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Banner: modo de prueba EN CURSO -->
                        <Border Background="#DBEAFE" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                                Visibility="{Binding IsTrialActive, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x23F3;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#1E3A8A" VerticalAlignment="Center"
                                           Text="{Binding TrialBannerText}"/>
                            </StackPanel>
                        </Border>

                        <!-- Banner: prueba TERMINADA, decidir -->
                        <Border Background="#FEF9C3" BorderBrush="#CA8A04" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                                Visibility="{Binding IsTrialAwaiting, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" TextWrapping="Wrap" Foreground="#854D0E" VerticalAlignment="Center"
                                           Text="{Binding TrialBannerText}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Quitar" Height="28" Padding="12,0" Margin="8,0,6,0"
                                            Background="#FEE2E2" Foreground="#991B1B" FontWeight="SemiBold"
                                            BorderThickness="0" Cursor="Hand" Click="BtnTrialRemove_Click"/>
                                    <Button Content="Conservar" Height="28" Padding="12,0"
                                            Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                                            BorderThickness="0" Cursor="Hand" Click="BtnTrialKeep_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Aviso: sin conexión al servicio -->
                        <Border Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                                Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x26D4;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#991B1B" VerticalAlignment="Center"
                                           Text="Sin conexión con el servicio LockSuite. El estado mostrado puede no reflejar la protección real. Verifique que el servicio esté en ejecución."/>
                            </StackPanel>
                        </Border>

                        <!-- Aviso: modo simulación (sin privilegios) -->
                        <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                                Visibility="{Binding IsSimulationMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x26A0;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#92400E" VerticalAlignment="Center"
                                           Text="Modo simulación: el filtro NO está activo. El servicio no pudo aplicar WFP (falta de privilegios de administrador). La navegación NO está siendo filtrada."/>
                            </StackPanel>
                        </Border>

                        <!-- Hero Banner -->
                        <Border Background="#1E40AF" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Protección por Lista Blanca Activa" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Todo internet está bloqueado por defecto. Solo las conexiones a sitios permitidos en la lista son resueltas y autorizadas temporalmente en WFP." 
                                               FontSize="13" Foreground="#DBEAFE" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="🔒" FontSize="36" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Stat Cards Grid -->
                        <UniformGrid Columns="3" Margin="0,0,0,20">
                            <!-- Card 1 -->
                            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,10,0"
                                    BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Dominios Permitidos" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding WhitelistPatternsCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                                    <TextBlock Text="Patrones activos en lista blanca" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2 -->
                            <Border Background="White" CornerRadius="8" Padding="16" Margin="5,0,5,0"
                                    BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Reglas WFP Dinámicas" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding ActiveDynamicRulesCount}" FontSize="24" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                                    <TextBlock Text="IPs autorizadas temporalmente" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3 -->
                            <Border Background="White" CornerRadius="8" Padding="16" Margin="10,0,0,0"
                                    BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Consultas DNS Procesadas" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding TotalQueries}" FontSize="24" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding AllowedQueries, StringFormat='Permitidas: {0}'}" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- System Details Card -->
                        <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Detalles del Sistema de Filtrado" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Resolutor DNS Local:" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" Text="127.0.0.1:53 (UDP) — Redirección NRPT Activa" FontWeight="Medium"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Servidores Upstream:" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" Text="1.1.1.1 (Cloudflare) / 8.8.8.8 (Google)" FontWeight="Medium"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Modo de Operación:" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" Text="Windows Filtering Platform (ALE Outbound Default-Deny)" FontWeight="Medium"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Resolutor DNS escuchando:" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" FontWeight="Medium"
                                               Text="{Binding IsDnsListening, Converter={StaticResource BoolYesNo}}"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Política ante Caída:" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" Text="Fail-Closed (Cerrado por defecto)" FontWeight="Medium"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2. VISTA: LISTA BLANCA -->
                <ScrollViewer x:Name="ViewListaBlanca" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Encabezado: servicios con un clic -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Servicios con un clic" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"
                                           Text="Cada botón habilita el servicio completo (inicio de sesión, imágenes, fuentes y adjuntos). El buscador de Google y Gemini siguen bloqueados igual."/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="+ Agregar Dominio" Height="32" Padding="14,0" VerticalAlignment="Top"
                                    Background="#10B981" Foreground="White" FontWeight="SemiBold"
                                    BorderThickness="0" Cursor="Hand" Click="BtnAddDomain_Click"/>
                        </Grid>

                        <!-- Tarjetas: Permitir Gmail / Google Chat / Google Drive / Google Fotos / prog.co.il / mitmachim.top -->
                        <ItemsControl ItemsSource="{Binding ServicePacks}" Margin="0,0,-10,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="14" Margin="0,0,10,10" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                        <Setter Property="Background" Value="#F0FDF4"/>
                                                        <Setter Property="BorderBrush" Value="#86EFAC"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Icono, nombre y estado -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="2" CornerRadius="10" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#64748B"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                                        <Setter Property="Foreground" Value="#166534"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="#334155"
                                                       TextWrapping="Wrap" Margin="0,8,0,0"/>

                                            <TextBlock Grid.Row="2" Text="{Binding Notice}" FontSize="11" Foreground="#92400E"
                                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}"/>

                                            <!-- Acciones: Permitir/Bloquear y Abrir -->
                                            <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button Content="{Binding ToggleText}" Height="30" Padding="12,0" Margin="0,0,8,0"
                                                        FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                                        Click="BtnServiceToggle_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="#10B981"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                                    <Setter Property="Background" Value="#E2E8F0"/>
                                                                    <Setter Property="Foreground" Value="#334155"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="Abrir ↗" Height="30" Padding="10,0"
                                                        Background="White" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1"
                                                        Cursor="Hand" ToolTip="Abre el servicio en el navegador (entra directo al inicio de sesión si hace falta)"
                                                        Tag="{Binding OpenUrl}" Click="BtnServiceOpen_Click"
                                                        Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}"/>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Detalle: todos los paquetes y sus dominios -->
                        <TextBlock Text="Paquetes y dominios" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,4"/>
                        <TextBlock FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="«ejemplo.com» habilita el sitio y sus subdominios; «=ejemplo.com» solo ese sitio exacto; «lh*.ejemplo.com» cualquier nombre que empiece así. Los paquetes de bloqueo (🚫) tienen prioridad sobre todo lo permitido."/>

                        <ItemsControl ItemsSource="{Binding Packs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Blocks}" Value="True">
                                                        <Setter Property="Background" Value="#FEF2F2"/>
                                                        <Setter Property="BorderBrush" Value="#FECACA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header del Paquete -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DomainSummary}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                                    <TextBlock Text="Bloqueo con prioridad: estos sitios quedan bloqueados aunque otro paquete los permita."
                                                               FontSize="11" Foreground="#991B1B" Margin="0,2,0,0" TextWrapping="Wrap"
                                                               Visibility="{Binding Blocks, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>

                                                <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}"
                                                          VerticalAlignment="Center" Content="{Binding EnabledLabel}"
                                                          Cursor="Hand" Click="ChkPackToggle_Click"/>
                                            </Grid>

                                            <!-- Dominios dentro del paquete -->
                                            <Expander Grid.Row="1" Header="Ver dominios incluidos" Margin="0,10,0,0" Foreground="#475569">
                                                <ItemsControl ItemsSource="{Binding Domains}" Margin="10,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding}" FontFamily="Consolas" FontSize="13" Foreground="#1E293B"/>
                                                                <Button Grid.Column="1" Content="✕" Width="22" Height="22"
                                                                        Background="#FEE2E2" Foreground="#EF4444" BorderThickness="0"
                                                                        ToolTip="Eliminar dominio" Cursor="Hand"
                                                                        Click="BtnRemoveDomain_Click" Tag="{Binding}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. VISTA: BLOQUEADOS RECIENTES (MODO APRENDIZAJE) -->
                <Grid x:Name="ViewRecientes" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Dominios bloqueados recientemente por el resolutor DNS:" 
                                   VerticalAlignment="Center" FontSize="13" Foreground="#475569"/>

                        <Button Grid.Column="1" Content="Vaciar Historial" Height="30" Padding="12,0"
                                Background="#E2E8F0" Foreground="#334155" BorderThickness="0"
                                Cursor="Hand" Click="BtnClearBlocked_Click"/>
                    </Grid>

                    <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                        <ListView ItemsSource="{Binding RecentBlocked}" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Dominio Intentado" Width="380">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel MaxWidth="360">
                                                    <TextBlock Text="{Binding Domain}" FontWeight="Medium" FontFamily="Consolas" FontSize="13"/>
                                                    <!-- Nota para el tutor: por qué está bloqueado y si conviene habilitarlo -->
                                                    <TextBlock Text="{Binding Domain, Converter={StaticResource BlockedDomainNote}}"
                                                               FontSize="11" Foreground="#92400E" TextWrapping="Wrap" Margin="0,2,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <Trigger Property="Text" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Hora" Width="120" DisplayMemberBinding="{Binding Timestamp, StringFormat='HH:mm:ss dd/MM'}"/>
                                    <GridViewColumn Header="Intentos" Width="70" DisplayMemberBinding="{Binding Count}"/>
                                    <GridViewColumn Header="Acción" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✓ Permitir" Height="24" Padding="10,0"
                                                        Background="#DCFCE7" Foreground="#166534" FontWeight="SemiBold"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Click="BtnAllowBlocked_Click" Tag="{Binding Domain}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>

                <!-- 4. VISTA: CONFIGURACIÓN -->
                <ScrollViewer x:Name="ViewConfig" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Card: Contraseña Maestra -->
                        <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,16"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Contraseña Maestra del Tutor" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                                <TextBlock Text="Protegida localmente con cifrado DPAPI y PBKDF2. Los usuarios estándar no pueden modificar la lista sin esta clave."
                                           FontSize="12" Foreground="#64748B" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                <Button Content="Modificar Contraseña Maestra..." Width="220" Height="32"
                                        HorizontalAlignment="Left" Background="#2563EB" Foreground="White"
                                        FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                        Click="BtnChangePassword_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Card: Políticas -->
                        <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,16"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Políticas de Red" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                                <CheckBox IsChecked="{Binding FailClosed}" Content="Modo Fail-Closed (Mantener red bloqueada si el servicio no corre)" 
                                          Margin="0,12,0,8" Cursor="Hand" IsEnabled="False"
                                          ToolTip="Siempre activo por seguridad: si el servicio deja de ejecutarse de forma inesperada, la red permanece bloqueada hasta reiniciar."/>
                                <CheckBox IsChecked="{Binding LearningMode}" Content="Modo Aprendizaje (Registrar dominios no permitidos para su aprobación)" 
                                          Margin="0,0,0,4" Cursor="Hand" Click="ChkLearningMode_Click"
                                          ToolTip="Requiere autenticación del tutor para cambiarlo."/>
                            </StackPanel>
                        </Border>

                        <!-- Card: Diagnóstico WFP -->
                        <Border Background="White" CornerRadius="8" Padding="18"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Prueba de Seguridad de Filtros WFP" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                                <TextBlock Text="Permite verificar que WFP bloquea correctamente el tráfico de salida y aplica auto-rollback en 30 segundos para evitar cualquier riesgo de desconexión accidental."
                                           FontSize="12" Foreground="#64748B" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                <Button Content="Ejecutar Prueba WFP (30s seguro)" Width="240" Height="32"
                                        HorizontalAlignment="Left" Background="#475569" Foreground="White"
                                        FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                        Click="BtnTestWfp_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 5. VISTA: AYUDA / FAQ -->
                <ScrollViewer x:Name="ViewAyuda" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Ayuda / Preguntas frecuentes" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                        <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="¿Puedo instalar programas en este equipo?" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                                <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#334155" TextWrapping="Wrap"
                                           Text="Sí. Podés usar el equipo con normalidad e instalar programas. Muchos programas se instalan en tu carpeta personal y no necesitan al administrador."/>
                                <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="#334155" TextWrapping="Wrap"
                                           Text="Si un instalador .exe te pide permisos de administrador pero en realidad no los necesita, hacé clic derecho sobre el archivo y elegí: «Instalar en mi usuario (sin administrador)». Se instalará en tu carpeta personal sin pedir la contraseña del administrador."/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="¿El filtro me deja sin internet en esos programas?" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                                <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#334155" TextWrapping="Wrap"
                                           Text="No. Podés usar cualquier programa o navegador. Lo único es que todos pasan por el mismo filtro de red: solo se conectan a los sitios permitidos en la lista blanca. Instalar más navegadores o apps no cambia eso: el filtro trabaja a nivel de red, no por programa."/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Necesito entrar a un sitio que está bloqueado" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                                <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#334155" TextWrapping="Wrap"
                                           Text="Pedile al tutor que lo agregue a la lista. El tutor lo hace desde «Lista Blanca», o desde «Bloqueados Recientes» con el botón Permitir, ingresando su contraseña."/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="¿Cómo entro a Gmail, Drive, Fotos o Chat?" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                                <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#334155" TextWrapping="Wrap"
                                           Text="Si el tutor los habilitó, usá los botones «Abrir» de «Lista Blanca» o estas direcciones: mail.google.com, drive.google.com/drive/my-drive, photos.google.com/login y chat.google.com/u/0/."/>
                                <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="#334155" TextWrapping="Wrap"
                                           Text="Las direcciones cortas (gmail.com, drive.google.com, photos.google.com) pasan por páginas publicitarias de Google que quedan bloqueadas mientras no hayas iniciado sesión. Una vez que iniciás sesión, funcionan normalmente."/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="¿Por qué no funciona el buscador de Google ni Gemini?" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                                <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#334155" TextWrapping="Wrap"
                                           Text="Están bloqueados a propósito, también cuando se permiten Gmail, Drive, Chat o Fotos. Para buscar dentro de Gmail o de Drive usá el buscador propio de cada uno. Las funciones de Gemini dentro de Gmail y Documentos también quedan bloqueadas."/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Una imagen o un video no se ve" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                                <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#334155" TextWrapping="Wrap"
                                           Text="Algunas cosas se bloquean a propósito: imágenes insertadas desde otros sitios, videos de YouTube, GIFs animados y publicidad. Si falta algo necesario, el tutor lo ve en «Bloqueados Recientes», con una nota que explica si conviene habilitarlo."/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Hay programas que igual piden administrador" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                                <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#334155" TextWrapping="Wrap"
                                           Text="Algunos instaladores necesitan al administrador de verdad (instalan un servicio o un controlador, o escriben en «Archivos de programa»). Esos los tiene que instalar el tutor. La opción «Instalar en mi usuario» solo sirve para los que piden administrador sin necesitarlo."/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="8" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Actualizaciones" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                                <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#334155" TextWrapping="Wrap"
                                           Text="LockSuite se actualiza solo, en segundo plano. No tenés que hacer nada."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>
    </Grid>

    <Window.Resources>
        <!-- Style para botones del menú de navegación lateral -->
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" CornerRadius="6" Background="Transparent" Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
